# --- Database ---
POSTGRES_USER=examflow
POSTGRES_PASSWORD=examflow
POSTGRES_DB=examflow
DATABASE_URL=postgresql+psycopg2://examflow:examflow@localhost:5432/examflow

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Email (Google Workspace SMTP with an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@yourdomain.com
SMTP_APP_PASSWORD=changeme
SMTP_FROM_NAME=Examflow

# --- Ticket storage ---
TICKET_STORAGE_DIR=./storage/tickets

# --- App ---
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=changeme
