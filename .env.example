# --- Database ---
POSTGRES_USER=examflow
POSTGRES_PASSWORD=examflow
POSTGRES_DB=examflow
DATABASE_URL=postgresql+psycopg2://examflow:examflow@localhost:5432/examflow
# Connection pool (total connections = DB_POOL_SIZE + DB_MAX_OVERFLOW; keep below your database's limit)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Encryption of sensitive student data (Aadhaar) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set it once and never change it — changing it makes already-stored Aadhaar numbers unreadable.
# If left empty, a key is derived from JWT_SECRET_KEY (fine for local development only).
FIELD_ENCRYPTION_KEY=

# --- OTP for student mobile verification and forgot password ---
# Options for OTP_PROVIDER:
#   startmessaging - StartMessaging OTP API (India). Their non-DLT OTP route sends from
#              a shared sender ID: NO DLT registration of your own needed. About Rs 0.25
#              per SMS from a prepaid wallet. Sign up at app.startmessaging.com, finish the
#              one-time KYC, add wallet balance, then API Keys -> Create API Key (sm_live_...).
#   firebase - Google Firebase Phone Authentication sends the SMS from Google's own
#              approved senders: NO DLT registration of your own needed. Fill in the
#              FIREBASE_* values below (Firebase console -> Project settings -> Your apps -> Web).
#   msg91    - your own MSG91 account + DLT-approved template (MSG91_* below).
#   console  - TEST MODE, no SMS at all. Never use in production.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=AIza...
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# OTP_PROVIDER=console is TEST MODE: no SMS is sent, OTPs appear in the backend log
# (and on screen if OTP_DEV_ECHO=true). Never run production in test mode.
# For real SMS: OTP_PROVIDER=msg91 plus your MSG91 auth key and the ID of the
# DLT-approved OTP template (MSG91 dashboard -> OTP -> Templates). The template
# must contain the ##OTP## variable.
OTP_PROVIDER=startmessaging
OTP_DEV_ECHO=false
STARTMESSAGING_API_KEY=
# Optional: template ID from the StartMessaging dashboard, and an app name for the
# {appName} placeholder in the SMS text.
# STARTMESSAGING_TEMPLATE_ID=
# STARTMESSAGING_APP_NAME=Combine Mentor
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Optional limits (defaults shown)
# OTP_EXPIRY_MINUTES=5
# OTP_RESEND_SECONDS=60
# OTP_MAX_SENDS_PER_HOUR=5
# OTP_MAX_SENDS_PER_IP_PER_HOUR=60
# OTP_MAX_ATTEMPTS=5

# --- Ticket storage ---
TICKET_STORAGE_DIR=./storage/tickets

# --- App ---
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin

# --- Public HTTPS domain (only needed for self-hosted docker-compose deployments) ---
# Camera access on the scanner app requires https (or localhost) — plain http over
# a bare server IP will NOT work. If you don't own a domain yet, sslip.io gives you
# a free working hostname for any server IP, no signup needed: replace the dots in
# your server's public IP with dashes and append ".sslip.io", e.g. IP 203.0.113.10
# becomes 203-0-113-10.sslip.io. Caddy (see Caddyfile) will fetch a real Let's Encrypt
# certificate for it automatically — just make sure ports 80 and 443 are open on your
# server's firewall.
#
# Everything is served off this single domain, split by path prefix:
#   https://<DOMAIN>/admin/    -> admin dashboard
#   https://<DOMAIN>/scan/     -> scanner PWA
#   https://<DOMAIN>/student/  -> student portal
#   https://<DOMAIN>/api/      -> backend API
DOMAIN=203-0-113-10.sslip.io

# Path prefixes the frontends are built to run under — must match the Caddyfile's
# handle_path blocks. Only change these if you also edit the Caddyfile to match.
ADMIN_BASE_PATH=/admin/
SCANNER_BASE_PATH=/scan/

# Relative by default so both frontends call the API on the same domain/origin they're
# served from (avoids CORS and keeps everything behind the one HTTPS cert above).
PUBLIC_API_URL=/api
