# --- Database ---
POSTGRES_USER=examflow
POSTGRES_PASSWORD=examflow
POSTGRES_DB=examflow
DATABASE_URL=postgresql+psycopg2://examflow:examflow@localhost:5432/examflow

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Email (Google Workspace SMTP with an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@yourdomain.com
SMTP_APP_PASSWORD=changeme
SMTP_FROM_NAME=Examflow

# --- Ticket storage ---
TICKET_STORAGE_DIR=./storage/tickets

# --- App ---
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin

# --- Public HTTPS domain (only needed for self-hosted docker-compose deployments) ---
# Camera access on the scanner app requires https (or localhost) — plain http over
# a bare server IP will NOT work. If you don't own a domain yet, sslip.io gives you
# a free working hostname for any server IP, no signup needed: replace the dots in
# your server's public IP with dashes and append ".sslip.io", e.g. IP 203.0.113.10
# becomes 203-0-113-10.sslip.io. Caddy (see Caddyfile) will fetch a real Let's Encrypt
# certificate for it automatically — just make sure ports 80 and 443 are open on your
# server's firewall.
#
# Everything is served off this single domain, split by path prefix:
#   https://<DOMAIN>/admin/    -> admin dashboard
#   https://<DOMAIN>/scanner/  -> scanner PWA
#   https://<DOMAIN>/api/      -> backend API
DOMAIN=203-0-113-10.sslip.io

# Path prefixes the frontends are built to run under — must match the Caddyfile's
# handle_path blocks. Only change these if you also edit the Caddyfile to match.
ADMIN_BASE_PATH=/admin/
SCANNER_BASE_PATH=/scanner/

# Relative by default so both frontends call the API on the same domain/origin they're
# served from (avoids CORS and keeps everything behind the one HTTPS cert above).
PUBLIC_API_URL=/api
