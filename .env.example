# --- Database ---
POSTGRES_USER=examflow
POSTGRES_PASSWORD=examflow
POSTGRES_DB=examflow
DATABASE_URL=postgresql+psycopg2://examflow:examflow@localhost:5432/examflow

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Email (Google Workspace SMTP with an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@yourdomain.com
SMTP_APP_PASSWORD=changeme
SMTP_FROM_NAME=Examflow

# --- Ticket storage ---
TICKET_STORAGE_DIR=./storage/tickets

# --- App ---
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin

# --- Public HTTPS domains (only needed for self-hosted docker-compose deployments) ---
# Camera access on the scanner app requires https (or localhost) — plain http over
# a bare server IP will NOT work. If you don't own a domain yet, sslip.io gives you
# free working hostnames for any server IP, no signup needed: replace the dots in
# your server's public IP with dashes and append ".sslip.io", e.g. IP 203.0.113.10
# becomes 203-0-113-10.sslip.io. Caddy (see Caddyfile) will fetch real Let's Encrypt
# certificates for these automatically — just make sure ports 80 and 443 are open
# on your server's firewall.
ADMIN_DOMAIN=admin.203-0-113-10.sslip.io
SCANNER_DOMAIN=scanner.203-0-113-10.sslip.io
API_DOMAIN=api.203-0-113-10.sslip.io
PUBLIC_API_URL=https://api.203-0-113-10.sslip.io
